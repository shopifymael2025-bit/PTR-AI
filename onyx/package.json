{
  "name": "ptr-ai",
  "productName": "PTR AI",
  "version": "1.4.0",
  "description": "PTR AI — A local-first AI coding agent for Windows and macOS.",
  "main": "./out/main/index.js",
  "author": "PTR AI",
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run icons && npm run build && electron-builder --win --x64",
    "dist:dir": "npm run icons && npm run build && electron-builder --win --x64 --dir",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "dist:mac": "npm run icons && npm run build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "app.ptrai.desktop",
    "productName": "PTR AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/sql.js/dist/*.wasm"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PTR AI",
      "artifactName": "PTR-AI-Setup-${version}.${ext}",
      "license": "LICENSE.txt"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "solarynteam",
        "repo": "ptr-ai",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "PTR-AI-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "PTR-AI-${version}-${arch}.${ext}",
      "title": "PTR AI ${version}"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "sql.js": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.7.0",
    "diff": "^9.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.14.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.77.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron@45.4.1": true
  }
}
